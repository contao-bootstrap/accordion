<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
        http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <defaults autoconfigure="true" public="false"/>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionGroupWrapperElementController">
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionWrapperElementController">
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionGroupStartElementController">
            <argument type="service" id="netzmacht.contao_toolkit.template_renderer"/>
            <argument type="service" id="netzmacht.contao_toolkit.routing.scope_matcher"/>
            <argument type="service" id="netzmacht.contao_toolkit.response_tagger"/>
            <argument type="service" id="contao.security.token_checker"/>
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
            <argument type="service" id="netzmacht.contao_toolkit.repository_manager"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionGroupEndElementController">
            <argument type="service" id="netzmacht.contao_toolkit.template_renderer"/>
            <argument type="service" id="netzmacht.contao_toolkit.routing.scope_matcher"/>
            <argument type="service" id="netzmacht.contao_toolkit.response_tagger"/>
            <argument type="service" id="contao.security.token_checker"/>
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
            <argument type="service" id="netzmacht.contao_toolkit.repository_manager"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionSingleElementController">
            <argument type="service" id="netzmacht.contao_toolkit.template_renderer"/>
            <argument type="service" id="netzmacht.contao_toolkit.routing.scope_matcher"/>
            <argument type="service" id="netzmacht.contao_toolkit.response_tagger"/>
            <argument type="service" id="contao.security.token_checker"/>
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
            <argument type="service" id="contao.image.studio"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionStartElementController">
            <argument type="service" id="netzmacht.contao_toolkit.template_renderer"/>
            <argument type="service" id="netzmacht.contao_toolkit.routing.scope_matcher"/>
            <argument type="service" id="netzmacht.contao_toolkit.response_tagger"/>
            <argument type="service" id="contao.security.token_checker"/>
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
            <argument type="service" id="netzmacht.contao_toolkit.repository_manager"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Components\ContentElement\AccordionEndElementController">
            <argument type="service" id="netzmacht.contao_toolkit.template_renderer"/>
            <argument type="service" id="netzmacht.contao_toolkit.routing.scope_matcher"/>
            <argument type="service" id="netzmacht.contao_toolkit.response_tagger"/>
            <argument type="service" id="contao.security.token_checker"/>
            <argument type="service" id="contao_bootstrap.core.helper.color_rotate"/>
            <argument type="service" id="netzmacht.contao_toolkit.repository_manager"/>
            <argument>%kernel.project_dir%</argument>
        </service>

        <service id="ContaoBootstrap\Accordion\Migration\PanelMigration">
            <argument type="service" id="database_connection"/>
            <tag name="contao.migration"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Migration\AccordionGroupWrapperMigration">
            <argument type="service" id="database_connection"/>
            <argument>%contao_bootstrap.grid.enable_wrapper_migration%</argument>
            <tag name="contao.migration"/>
        </service>

        <service id="ContaoBootstrap\Accordion\Migration\AccordionWrapperMigration">
            <argument type="service" id="database_connection"/>
            <argument>%contao_bootstrap.grid.enable_wrapper_migration%</argument>
            <tag name="contao.migration"/>
        </service>
    </services>
</container>

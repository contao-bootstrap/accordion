<?php if (! $this->groupId): ?><div class="accordion"><?php endif ?>
<div class="<?= $this->class ?> accordion-item"<?= $this->cssID ?>>
    <div class="accordion-header" id="<?= $this->headingId ?>">
        <<?= $this->hl ?> class="mb-0">
            <button class="accordion-button<?php if (!$this->expanded): ?> collapsed<?php endif ?>"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#<?= $this->collapseId ?>"
                    role="tab"
                    aria-expanded="<?= $this->expanded ? 'true' : 'false' ?>"
                    aria-controls="<?= $this->collapseId ?>">
                <?= $this->headline ?>
            </button>
        </<?= $this->hl ?>>
    </div>

    <div id="<?= $this->collapseId ?>"
         class="accordion-collapse collapse<?php if ($this->expanded): ?> show<?php endif ?>"
         role="tabpanel"
         aria-labelledby="<?= $this->headingId ?>"
         <?php if ($this->groupId): ?>data-bs-parent="#<?= $this->groupId ?>"<?php endif ?>>
        <div class="accordion-body clearfix">
            <?php if (!$this->addBefore): ?>
                <?= $this->text ?>
            <?php endif; ?>

            <?php if ($this->addImage): ?>
                <?php $this->insert('image', $this->arrData); ?>
            <?php endif; ?>

            <?php if ($this->addBefore): ?>
                <?= $this->text ?>
            <?php endif; ?>
        </div>
    </div>
</div>
<?php if (! $this->groupId): ?></div><?php endif ?>

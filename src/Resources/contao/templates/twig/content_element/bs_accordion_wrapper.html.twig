{% set attributes = attrs()
  .setIfExists('id', element_html_id|default('accordion-' ~ data.id))
  .addClass([element_css_classes, "content-#{type|replace({'_': '-'})}", "accordion-item"])
  .mergeWith(attributes|default) %}

{% if not groupId %}
<div class="accordion">
  {% endif %}
  <div {{ attributes }}>
    <div class="accordion-header" id="{{ headingId }}">
      {% set headline_boostrap_attributes = attrs()
        .addClass('mb-0') %}

      {% set headline = headline|merge({
        attributes: headline.attributes|default(attrs()).mergeWith(headline_boostrap_attributes)
      }) %}

      {% embed '@Contao/component/_headline.html.twig' with {
        headline: headline
      } only %}
        {% block headline_inner %}
          <button class="accordion-button{% if not expanded %} collapsed{% endif %}"
                  type="button"
                  role="tab"
                  data-bs-toggle="collapse"
                  data-bs-target="#{{ collapseId }}"
                  aria-expanded="{{ expanded ? 'true' : 'false' }}"
                  aria-controls="{{ collapseId }}">
            {{ headline.text|insert_tag_raw }}
          </button>
        {% endblock %}
      {% endembed %}
    </div>

    <div id="{{ collapseId }}"
         class="accordion-collapse collapse{% if expanded %} show{% endif %}"
         role="tabpanel"
         aria-labelledby="{{ headingId }}"
         {% if groupId %}data-bs-parent="#{{ groupId }}"{% endif %}>
      <div class="accordion-body">
        {% for fragment in nested_fragments %}
          {{ content_element(fragment) }}
        {% endfor %}
      </div>
    </div>
  </div>
  {% if not groupId %}
</div>
{% endif %}

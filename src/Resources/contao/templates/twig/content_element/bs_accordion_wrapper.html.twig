{% if isBackend %}
<div><span style="color: {{ color }}">{{ headline.value }}</span></div>
<ul>
  {% for fragment in nested_fragments %}
    {% set contentModel = content_model(fragment.attributes.contentModel) %}
    <li>
      <div class="tl_content click2edit toggle_select">
        <div class="cte_type published">{{ ('CTE.'  ~ contentModel.type ~ '.0')|trans({}, 'contao_modules') }}</div>
        <div class="cte_preview" style="contain:paint">
          {{ content_element(fragment) }}
        </div>
      </div>
    </li>
  {% endfor %}
</ul>
{% else %}
{% if not groupId %}
<div class="accordion">
  {% endif %}
  <div class="{{ class }} accordion-item"{{ cssID }}>
    <div class="accordion-header" id="{{ headingId }}">
      <{{ headline.unit }} class="mb-0">
      <button class="accordion-button{% if not expanded %} collapsed{% endif %}"
              type="button"
              role="tab"
              data-bs-toggle="collapse"
              data-bs-target="#{{ collapseId }}"
              aria-expanded="{{ expanded ? 'true' : 'false' }}"
              aria-controls="{{ collapseId }}">
        {{ headline.value }}
      </button>
    </{{ headline.unit }}>
  </div>

  <div id="{{ collapseId }}"
       class="accordion-collapse collapse{% if expanded %} show{% endif %}"
       role="tabpanel"
       aria-labelledby="{{ headingId }}"
       {% if groupId %}data-bs-parent="#{{ groupId }}"{% endif %}>
    <div class="accordion-body">
      {% for fragment in nested_fragments %}
        {{ content_element(fragment) }}
      {% endfor %}    </div>
  </div>
  {% endif %}
